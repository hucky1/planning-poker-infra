# Production template (do not commit real secrets).
# Use with: docker compose --env-file .env.production -f compose.yaml up -d

APP_ENV=prod
APP_DEBUG=0

# Required prebuilt images
BACKEND_IMAGE=ghcr.io/hucky1/planning-poker-backend:latest
FRONTEND_IMAGE=ghcr.io/hucky1/planning-poker-frontend:latest

# Backend HTTP runtime contract
BACKEND_INTERNAL_PORT=8080
BACKEND_HEALTHCHECK_PATH=/health

# Published frontend port
FRONTEND_PORT=80

# Required runtime service URLs (prefer secret manager / CI variables)
DATABASE_URL=postgresql://__REPLACE_WITH_SECRET__@your-db-host:5432/planning_poker?serverVersion=17&charset=utf8
REDIS_URL=redis://your-redis-host:6379

# Frontend runtime API URL
NEXT_PUBLIC_API_URL=https://api.your-domain.com
