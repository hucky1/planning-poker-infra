# Local development template
# Use with: docker compose -f compose.dev.yaml --env-file .env up --build

# Runtime image tags for local dev helpers
PHP_VERSION=8.5-fpm-alpine
COMPOSER_VERSION=2
NODE_VERSION=20-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
INSTALL_XDEBUG=0

# Local host port mapping
BACKEND_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local app runtime values
APP_ENV=dev
APP_DEBUG=1
RUN_MIGRATIONS=0
VITE_API_URL=http://localhost:8080

# Local service credentials/URLs
POSTGRES_DB=planning_poker
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@db:5432/planning_poker?serverVersion=17&charset=utf8
REDIS_URL=redis://redis:6379

# Xdebug
# Xdebug is installed only when INSTALL_XDEBUG=1 during image build.
XDEBUG_MODE=off
XDEBUG_START_WITH_REQUEST=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_DISCOVER_CLIENT_HOST=0
XDEBUG_IDEKEY=VSCODE
